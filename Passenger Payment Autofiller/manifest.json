{
   "action": {
      "default_icon": "irct.png",
      "default_popup": "index.html"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js", "payments.js", "autoCnfPayments.js"],
      "matches": [ "*://www.irctc.co.in/*" ]
   } ],
   "description": "Auto-fills IRCTC passenger details for General and Tatkal ticket booking using saved data",
   "host_permissions": [ "*://www.irctc.co.in/*" ],
   "key": "",
   "manifest_version": 3,
   "name": "IRCTC Fast Ticket Booker",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.3"
}
